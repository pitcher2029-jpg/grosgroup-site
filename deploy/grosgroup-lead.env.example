# /etc/grosgroup-lead.env — права 600, владелец root. Нужен хотя бы один канал доставки.
# Описание переменных: server/README.md

# Почта (Яндекс 360: пароль приложения, не пароль ящика)
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=site@grosgroup.ru
SMTP_PASS=
MAIL_FROM=GROSGROUP <site@grosgroup.ru>
MAIL_TO=info@grosgroup.ru

# Telegram — трансграничная передача ПДн: включать только после уведомления Роскомнадзора (LAUNCH.md)
#TG_BOT_TOKEN=
#TG_CHAT_ID=

# CRM
#WEBHOOK_URL=
#WEBHOOK_TOKEN=
